# Modèle de configuration locale.
# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.

# Identifiants administrateur de MinIO (mot de passe : 8 caractères minimum)
MINIO_ROOT_USER=admin-lakehouse
MINIO_ROOT_PASSWORD=remplacer-par-un-mot-de-passe

# Nom du bucket qui contiendra les couches bronze, silver et gold
LAKEHOUSE_BUCKET=lakehouse
